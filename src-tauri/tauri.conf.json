{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GayanShop POS",
  "version": "0.1.0",
  "identifier": "com.gayanshop.pos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GayanShop POS",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 768,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; media-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4NkIwRTY3NzI3NEJBNzEKUldSeHVuUnladzVyMklVNmtoSXJtMHRTc3lQdWNJTXduL3BzaDFCQVRod0dtaVlpWWFGamZJeUkK",
      "endpoints": [
        "https://github.com/gayanshop/pos/releases/latest/download/latest.json"
      ]
    }
  }
}
